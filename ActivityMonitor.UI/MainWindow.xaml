<Window
    x:Class="ActivityMonitor.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ActivityMonitor.UI">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0"
                     PlaceholderText="検索（プロセス名 / PID）"
                     TextChanged="SearchBox_TextChanged" />

            <ComboBox x:Name="IntervalBox" Grid.Column="1" SelectedIndex="1"
                      SelectionChanged="IntervalBox_SelectionChanged">
                <ComboBoxItem Content="0.5秒" Tag="500" />
                <ComboBoxItem Content="1秒" Tag="1000" />
                <ComboBoxItem Content="2秒" Tag="2000" />
            </ComboBox>

            <Button x:Name="KillButton" Grid.Column="2" Content="プロセスを終了"
                    IsEnabled="False" Click="KillButton_Click" />
        </Grid>

        <!-- ヘッダ（クリックでソート） -->
        <Grid Grid.Row="1" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Button x:Name="HeaderName" Grid.Column="0" Tag="name" Click="Header_Click"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
            <Button x:Name="HeaderPid" Grid.Column="1" Tag="pid" Click="Header_Click"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <Button x:Name="HeaderCpu" Grid.Column="2" Tag="cpu" Click="Header_Click"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <Button x:Name="HeaderTime" Grid.Column="3" Tag="time" Click="Header_Click"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <Button x:Name="HeaderThreads" Grid.Column="4" Tag="threads" Click="Header_Click"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <Button x:Name="HeaderMemory" Grid.Column="5" Tag="memory" Click="Header_Click"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
        </Grid>

        <!-- プロセス一覧（ListViewは既定で仮想化される） -->
        <ListView x:Name="ProcessList" Grid.Row="2"
                  ItemsSource="{x:Bind Rows}"
                  SelectionMode="Single"
                  SelectionChanged="ProcessList_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProcessRow">
                    <Grid Padding="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind PidText, Mode=OneWay}"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind CpuText, Mode=OneWay}"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind CpuTimeText, Mode=OneWay}"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind ThreadsText, Mode=OneWay}"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{x:Bind MemoryText, Mode=OneWay}"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- CPU LOAD フッタ -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0">
            <Grid x:Name="CpuBar" Height="10" CornerRadius="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="UserCol" Width="0*" />
                    <ColumnDefinition x:Name="SystemCol" Width="0*" />
                    <ColumnDefinition x:Name="IdleCol" Width="100*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCriticalBrush}" />
                <Border Grid.Column="2" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
            </Grid>
            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
